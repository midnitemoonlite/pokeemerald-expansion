raw `
MallowCastle_4F_MapScripts::
	.byte 0
`

script MallowCastle_4F_EventScript_WaddleDeeTutorial
{
    lock
    faceplayer
    msgbox("Pant\. pant\.
    
            This bomb block\. it's a real doozy, I
            tell you what\.
            
            Once this path opens, it'll keep on
            going until it closes the other exit.
            
            You'll have to run as fast as you can to
            make it there before that happens\.
            
            \.pant\. I'm not a very fast runner, as it
            turns out\.")
    release
}

script MallowCastle_4F_EventScript_WaddleDeeObstacle1
{
    lock
    faceplayer
    msgbox("Hi, Kirby. I appreciate you stopping by
            and talking to me.
            
            Don't you think there's something else
            you should be focusing on, though?")
    release
}

script MallowCastle_4F_EventScript_WaddleDeeObstacle2
{
    lock
    faceplayer
    msgbox("I'm too busy walking in circles to tell
            which way you're coming from.
            
            Hopefully it's not walking back to the
            start because you were too slow?")
    release
}

script MallowCastle_4F_EventScript_WaddleDeeObstacle3
{
    lock
    faceplayer
    msgbox("Walking back and forth like this would
            be more fun if I could see my footsteps.
            Maybe I should visit the Iceberg next.")
    release
}

script MallowCastle_4F_EventScript_WaddleDeeObstacle4
{
    lock
    faceplayer
    msgbox("Nobody uses this castle for anything,
            right? Then I say we should make
            a race course out of it!
            
            It'd be so much fun driving laps down
            all the twisty-turny hallways!")
    release
}

script MallowCastle_4F_EventScript_WaddleDeeObstacle5
{
    lock
    faceplayer
    msgbox("You're almost at the end, Kirby! Just a
            few more steps to the Castle Arena!")
    release
}

