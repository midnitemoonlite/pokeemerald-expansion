script WaddleDeeTown_Mart_EventScript_TaughtMove
{
    showmoneybox(0,0)
    delay(16)
    removemoney(500)
    updatemoneybox()
    playse(SE_SHOP)
    msgbox("All done! I hope you and your Helper will
            make the most of this new technique!")
	copyvar(VAR_0x8004, VAR_0x8008)
    hidemoneybox()
    release
}