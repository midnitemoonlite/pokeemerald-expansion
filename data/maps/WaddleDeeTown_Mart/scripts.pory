raw `
WaddleDeeTown_Mart_MapScripts::
	.byte 0
`

script WaddleDeeTown_Mart_EventScript_Clerk
{
	lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
	pokemart(WaddleDeeTown_Mart)
	msgbox(gText_PleaseComeAgain)
	release
	end
}

mart WaddleDeeTown_Mart
{
    ITEM_POKE_BALL
    ITEM_HEAL_BALL
    ITEM_POTION
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_POKE_DOLL
    ITEM_DIRE_HIT
}

script WaddleDeeTown_Mart_EventScript_Delivery
{
    lock
    faceplayer
    msgbox("There's a department store being built
            in the northeast corner of town.
            
            It'll be hard for this shop to compete
            with the variety of items sold there\.")
    release
}

script WaddleDeeTown_Mart_EventScript_Socialite
{
    lock
    faceplayer
    msgbox("Even when the department store opens,
            I'll keep coming back to this shop.
            
            I come by often enough for the clerks
            to recognize me. It's hard to beat
            that level of familiarity!")
    release
}

// Move Tutor

script WaddleDeeTown_Mart_EventScript_MoveTutor
{
    lock
    faceplayer
    if(!flag(FLAG_BADGE01_GET))
    {
        msgbox(MoveTutor_Text_MoveTutorNotEnabled, MSGBOX_DEFAULT)
    }
    else
    {
        goto(WaddleDeeTown_Mart_EventScript_MoveTutorEnabled)
    }
    release   
}

script WaddleDeeTown_Mart_EventScript_MoveTutorEnabled
{
    msgbox("Having heard of your recent victory\.
            I feel so invigorated! Wroaaar!
            
            I know some special moves that can
            be taught to your Helpers.
            
            For the price of ¥500, I'll train
            them these new techniques.")
    message("What do you say?
            Which move are you interested in?")
    waitmessage()
    showmoneybox(0, 0)
    multichoice(20, 0, MULTI_WADDLE_DEE_MOVELIST, FALSE)
    copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
    switch(var(VAR_RESULT)) {
	case 0:
		goto(WaddleDeeTown_Mart_EventScript_Move1)
	case 1:
		goto(WaddleDeeTown_Mart_EventScript_Move2)
	case 2:
		goto(WaddleDeeTown_Mart_EventScript_Move3)
    case 3:
		goto(WaddleDeeTown_Mart_EventScript_Move4)
    case 4:
		goto(WaddleDeeTown_Mart_EventScript_Move5)
    case MULTI_B_PRESSED:
        goto(MoveTutor_EventScript_MoveTutorLeave)
    }
}

script WaddleDeeTown_Mart_EventScript_Move1
{
    setvar(VAR_0x8005, MOVE_GRASS_KNOT)
    special(BufferBattleFrontierTutorMoveName)
    checkmoney(500)
    if(!var(VAR_RESULT))
    {
        goto(MoveTutor_EventScript_CantAfford)
    }
    move_tutor(MOVE_GRASS_KNOT, MoveTutor_Text_TeachMove, MoveTutor_Text_SelectMon, MoveTutor_EventScript_MoveTutorLeave, WaddleDeeTown_Mart_EventScript_TaughtMove)
}

