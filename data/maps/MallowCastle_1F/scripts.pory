script MallowCastle_1F_EventScript_Blockin
{
    lockall
    setwildbattle(SPECIES_BLOCKIN, 25)
    playmoncry(SPECIES_BLOCKIN, CRY_MODE_NORMAL)
    waitmoncry
    msgbox("Uh oh! The Star Block was actually
            a Blockin in disguise!")
    playmoncry(SPECIES_BLOCKIN, CRY_MODE_ENCOUNTER)
    waitmoncry
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle()
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    removeobject(LOCALID_BLOCKIN_MALLOW_CASTLE)
    setflag(FLAG_TEMP_18)
    release
}

script MallowCastle_1F_EventScript_Trainer
{
    trainerbattle_single(TRAINER_PARKER, MallowCastle_1F_Text_TrainerIntro, MallowCastle_1F_Text_TrainerDefeated)
    msgbox(MallowCastle_1F_Text_TrainerPost, MSGBOX_AUTOCLOSE)
}

text MallowCastle_1F_Text_TrainerIntro
{
    "Do you think if I become Dream Land's
    king, I can change my title to queen?"
}

text MallowCastle_1F_Text_TrainerDefeated
{
    "My queenly dreams are one step farther
    away now\."
}

text MallowCastle_1F_Text_TrainerPost
{
    "Maybe we can all share Dream Land's
    crown, and form a royal court together?
    That way, we'll all be kings and queens!"
}