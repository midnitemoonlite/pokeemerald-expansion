raw `
MallowCastle_1F_MapScripts::
    map_script MAP_SCRIPT_ON_LOAD, MallowCastle_1F_OnLoad
	.byte 0

MallowCastle_1F_OnLoad:
	call_if_set FLAG_MET_RIVAL_MOM, MallowCastle_1F_EventScript_OpenShortcut
	end
`

script MallowCastle_1F_EventScript_OpenShortcut
{
    setmetatile(8, 21, METATILE_LilycoveMuseum_Floor, FALSE)
    setmetatile(7, 21, METATILE_LilycoveMuseum_DarkFloor, FALSE)
    setmetatile(8, 22, METATILE_LilycoveMuseum_Floor, FALSE)
    setmetatile(7, 22, METATILE_LilycoveMuseum_DarkFloor, FALSE)
    return
}

script MallowCastle_1F_EventScript_WaddleDee
{
    lock
    faceplayer
    if(!flag(FLAG_TEMP_10))
    {
        msgbox("If you find a bomb block, you should
            give it a good hit!
            
            It'll blow up, and take out any other
            sturdy blocks in its path as well!
            
            Now\. I'm afraid of explosives, so can
            you try it out yourself, please?")
    }
    else
    {
        msgbox("Eep! I stood a little too close to those
                metal blocks for comfort\.
                
                But now you know how bomb blocks work.
                And the path forward is open! Hooray!")
    }
    release
}

// Bomb Blocks

script MallowCastle_1F_EventScript_BombBlock1
{
    lockall
    playse(SE_M_DIG)
    removeobject(LOCALID_BOMB_MALLOW_CASTLE_1F_1)
    setflag(FLAG_TEMP_10)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    playse(SE_M_DIG)
    setmetatile(5, 44, METATILE_LilycoveMuseum_Floor, FALSE)
    special(DrawWholeMapView)
    setvar(VAR_0x8004, 1)  // vertical pan
