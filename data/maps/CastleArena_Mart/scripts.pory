raw `
CastleArena_Mart_MapScripts::
	.byte 0
`

script CastleArena_Mart_EventScript_Clerk
{
	lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
	pokemart(CastleArena_Mart)
	msgbox(gText_PleaseComeAgain)
	release
	end
}

mart CastleArena_Mart
{
    ITEM_POKE_BALL
    ITEM_GREAT_BALL
    ITEM_LUXURY_BALL
    ITEM_POTION
    ITEM_SUPER_POTION
    ITEM_REVIVE
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_BURN_HEAL
    ITEM_ICE_HEAL
    ITEM_REPEL
    ITEM_POKE_DOLL
    ITEM_DIRE_HIT
}

script CastleArena_Mart_EventScript_Nurse
{
    lock
    faceplayer
    msgbox("Umm\. isn't this supposed to be the
            break room? Where am I?
            
            Ohhhh\. don't tell me I mixed up
            my colors again\.")
    release
}

script CastleArena_Mart_EventScript_Chef
{
    lock
    faceplayer
    msgbox("I'm stocking up on as many 1-Ups as I
            can. They're a miracle item!
            
            I can't believe how generous the Great
            King is for offering them in shops now.")
    release
}

script CastleArena_Mart_EventScript_Worker
{
    lock
    faceplayer
    msgbox("With the avalanche in Waddle Dee Town,
            Dream Land is basically split in half\.
            
            I wonder what kinds of competitors are
            battling in the Arenas over there.")
    release
}

// Move Tutor

script CastleArena_Mart_EventScript_MoveTutor
{
    lock
    faceplayer
    if(!flag(FLAG_BADGE03_GET))
    {
        msgbox(MoveTutor_Text_MoveTutorNotEnabled, MSGBOX_DEFAULT)
    }
    else
    {
        goto(CastleArena_Mart_EventScript_MoveTutorEnabled)
    }
    release   
}

script CastleArena_Mart_EventScript_MoveTutorEnabled
{
    msgbox("Having heard of your recent victory\.
            I feel so invigorated! Wroaaar!
            
            I know some special moves that can
            be taught to your Helpers.
            
            For the price of ¥1500, I'll train
            them these new techniques.")
    message("What do you say?
            Which move are you interested in?")
    waitmessage()
    showmoneybox(0, 0)
    multichoice(20, 0, MULTI_PALACE_MOVELIST, FALSE)
    copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
    switch(var(VAR_RESULT)) {
	case 0:
		goto(CastleArena_Mart_EventScript_Move1)
	case 1:
		goto(CastleArena_Mart_EventScript_Move2)
	case 2:
		goto(CastleArena_Mart_EventScript_Move3)
    case 3:
		goto(CastleArena_Mart_EventScript_Move4)
    case 4:
		goto(CastleArena_Mart_EventScript_Move5)
    case MULTI_B_PRESSED:
        goto(MoveTutor_EventScript_MoveTutorLeave)
    }
}

script CastleArena_Mart_EventScript_Move1
{
    setvar(VAR_0x8005, MOVE_MYSTICAL_FIRE)
    special(BufferBattleFrontierTutorMoveName)
    checkmoney(1000)
    if(!var(VAR_RESULT))
    {
        goto(MoveTutor_EventScript_CantAfford)
    }
    move_tutor(MOVE_MYSTICAL_FIRE, MoveTutor_Text_TeachMove, MoveTutor_Text_SelectMon, MoveTutor_EventScript_MoveTutorLeave, CastleArena_Mart_EventScript_TaughtMove)
}

