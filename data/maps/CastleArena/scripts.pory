script CastleArena_EventScript_TalkToVCrowd1
{
    lockall
    turnvobject(0, DIR_SOUTH)
    if(!flag(FLAG_BADGE03_GET))
    {
        msgbox("I can't get enough of seeing Francisca
                freeze her opponent's Helpers!
                
                Being frozen sounds like so much fun\.
                Oh, Francisca, please let it be me next!")
    }
    else
    {
        msgbox("What? You managed to defeat the
                wonderful Francisca? How could you!?
                
                Oooh\. this burning feeling in my heart\.
                is this what Flamberge always feels!?")
    }
