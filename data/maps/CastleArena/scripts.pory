script CastleArena_EventScript_TalkToVCrowd2
{
    lockall
    turnvobject(1, DIR_SOUTH)
    if(!flag(FLAG_BADGE03_GET))
    {
        msgbox("My pals here are real big fans of
                Francisca and Flamberge, so you'd think
                you'd know what to expect from me.
                
                There's just one problem though\.
                
                I can't be the biggest fan of someone
                whose name I can't even remember!")
    }
    else
    {
        msgbox("Whoa, you must be pretty talented if
                you managed to beat\. uhh\.
                
                Hold on, it's coming to me\.
                
                \.
                
                \. Aha!
                
                Santa's Party Sack! That was it! Yeah,
                good job winning against her.")
    }
    release
}

script CastleArena_EventScript_TalkToVCrowd3
