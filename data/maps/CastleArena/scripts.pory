raw `
CastleArena_MapScripts::
    map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, CastleArena_OnWarp
    map_script MAP_SCRIPT_ON_RETURN_TO_FIELD, CastleArena_OnReturnToField
	.byte 0
CastleArena_OnWarp:
	map_script_2 VAR_TEMP_1, 0, CastleArena_EventScript_CreateAudience
	.2byte 0

CastleArena_OnReturnToField:
	goto CastleArena_EventScript_CreateAudience
	end
`

// Audience V-Objects
script CastleArena_EventScript_CreateAudience
{
    setvar(VAR_TEMP_1, 0)
    if(var(VAR_TEMP_1) == 0)
    {
        createvobject(OBJ_EVENT_GFX_CAMPER, 0, 22, 5, 3, DIR_SOUTH)
        createvobject(OBJ_EVENT_GFX_HEX_MANIAC, 1, 23, 5, 3, DIR_SOUTH)
        createvobject(OBJ_EVENT_GFX_MAN_5, 2, 24, 5, 3, DIR_SOUTH)
        setvar(VAR_TEMP_1, 5)
    }
    end
}
// Important NPCs 

script CastleArena_EventScript_Francisca
{
    lock
    faceplayer
    if(flag(FLAG_RECEIVED_TM_SHOCK_WAVE))
    {
        msgbox("{SPEAKER NAME_FRANCISCA}I wish Lord Hyness would have come with
                us to experience the Royal Royale\.
                
                He rarely seems to enjoy going out if it
                doesn't aid his own research, though.
                
                Maybe I should catch a Helper to bring
                back to him? That would be nice\.
                
                I bet he would be fond of Pierre. It has
                a delightfully large nose like his!")
    }
    elif(!flag(FLAG_RECEIVED_TM_SHOCK_WAVE) && flag(FLAG_BADGE03_GET))
    {
        msgbox("I should have expected no less from
                you, Kirby. To defeat both Ms. Flamberge
                and Ms. Zan after me is truly stellar.
                
                In fact, I would like to impart a little
                gift upon you. Take it, won't you?")
        giveitem(ITEM_TM91)
        msgbox("Many Helpers can learn Ice Punch, even
                if they aren't of the Ice type.
                
                Use it to spread the power of the
                bitter cold amongst your team.")
        setflag(FLAG_RECEIVED_TM_SHOCK_WAVE)
    }
    elif(!flag(FLAG_RECEIVED_TM_SHOCK_WAVE) && !flag(FLAG_BADGE03_GET))
    {
        msgbox("{SPEAKER NAME_FRANCISCA}My, my, look who it is. Have you been
                keeping well, Kirby?
                
                My fellow sisters and I have been
                travelling together for some time.
                
                Now, we're participating in the Royal
                Royale as a collective as well.
                
                You might think there can only be one
                winner at the end of the day\.
                
                But you'll soon find we're more than
                willing to share the spoils. Ohoho!")
    }
    release
}

script CastleArena_EventScript_Flamberge
{
    lock
    faceplayer
    if(flag(FLAG_RECEIVED_TM_OVERHEAT))
    {
        msgbox("You know, I asked Francisca why we
                didn't just move on after getting
                Brooches for the three of us\.
                
                You know what she said? It'd be good
                to offer extras to potential followers.
                
                Maybe, though\. she just really liked
                the thrill of building a big win streak!
                
                Ha ha ha! Oh, that Francisca! She's so
                cool when she's focused on battles!")
    }
    elif(!flag(FLAG_RECEIVED_TM_OVERHEAT) && flag(FLAG_BADGE03_GET))
    {
        msgbox("Hey, can't you see I'm busy trying to
                cheer poor Francisca up?
                
                Sheesh, you're annoying\. look, will you
                quit being a pest if I give you this?")
        giveitem(ITEM_TM13)
        msgbox("That TM teaches Fire Punch. It's a cool
                move you can teach to your Helpers.
                
                \.man, I really can't believe you managed
                to topple our invincible strategy.
                
                Will you ever stop being full of
                bothersome surprises?")
        setflag(FLAG_RECEIVED_TM_OVERHEAT)
    }
    elif(!flag(FLAG_RECEIVED_TM_OVERHEAT) && !flag(FLAG_BADGE03_GET))
    {
        msgbox("{SPEAKER NAME_FLAMBERGE}Ahahaha! Look who it is! Let me guess,
                you're here to take on the Arena too?
                
                Lemme warn you, shorty, you're in for a
                world of trouble if you take it on!
                
                Us three sisters are way tougher now!
                We've been strengthening our teamwork!
                And now\. we're basically invincible!")
    }
    release
}

script CastleArena_EventScript_ZanPartizanne
{
    lock
    faceplayer
    if(flag(FLAG_RECEIVED_TM_FACADE))
    {
        msgbox("{SPEAKER NAME_ZAN}I must admit\. that friend of yours,
                the king who put together this event,
                I did not assume much of him initially.

                He seemed\. poorly fit for his status.
                Greedy. Slovenly. Easily corruptible.

                And yet, he put together a game to
                teach the importance of collaboration
                and teamwork, and unite his people\.

                Perhaps I misjudged him. It seems he
                does know what makes a good leader,
                even if he struggles to show it\.")
    }
    elif(!flag(FLAG_RECEIVED_TM_FACADE) && flag(FLAG_BADGE03_GET))
    {
        msgbox("{SPEAKER NAME_ZAN}\.jamanke, Kirby. It's not easy to say
                that\.
                
                I realize now, though, that we've been
                sidetracked from our original mission.
                
                We need to move on to other Arenas, so
                we may have a shot at the grand prize\.

                And more importantly, we must continue 
                to learn and practice from experience.
                
                Here. It's not much, but I hope you can
                forgive the trouble we've caused here.")
        giveitem(ITEM_TM30)
        msgbox("This TM is for the move Thunder Punch.
                It has a change to paralyze the target.
                
                Stopping my opponents right where they
                stand has always been my strategy.")
        setflag(FLAG_RECEIVED_TM_FACADE)
    }
    elif(!flag(FLAG_RECEIVED_TM_FACADE) && !flag(FLAG_BADGE03_GET))
    {
        msgbox("{SPEAKER NAME_ZAN}Ah\. it's you, Kirby. Bonjam. Are you
                participating in the Royal Royale too?
                
                We, the three Mage-Sisters, would quite
                like to try our hand at the grand prize.
                
                I believe it would do wonders for our
                following, so I devised a plan with the
                other generals to guarantee victory.
                
                Should you choose to challenge the
                Arena regardless\. well, good luck.")
    }
    release
}

script CastleArena_EventScript_Nago
{
    lock
    if(!flag(FLAG_BADGE03_GET))
    {
        msgbox("{SPEAKER NAME_NAGO}Mrrow\. these girls are a real piece of
            work, I'll tell ya what!
            
            Gloating about their teamwork and their
            unstoppable Arena-winning strategy\.
            
            It makes me wanna win against them all
            the more, and yet I just keep losing!
            Can't anyone do something about them?")
    }
    else
    {
        faceplayer
        msgbox("Kirby! I didn't even notice you there.
                Sorry about that, mrrow!
                
                I was really impressed by your Helpers.
                They might be even stronger than mine!
                
                Mrrow! Let's have a battle sometime,
                okay, buddy?")
    }
    release
}

script CastleArena_EventScript_Shiro
{
    lock
    faceplayer
    if(!flag(FLAG_BADGE03_GET))
    {
        msgbox("Myew\. it really makes me sad to see
            Nago get so worked up. Can't we all
            get along and play nice?")
    }
    else
    {
        msgbox("Myew! Nago's looking a lot happier now.
                I'm so relieved!")
    }
    release
}

// Move Tutor

script CastleArena_EventScript_MoveTutor
{
    lock
    faceplayer
    if(!flag(FLAG_BADGE03_GET))
    {
        msgbox("I'm a movesmith. I know all sorts of
                long-forgotten techniques.
                
                What I'm looking for\. is a commander
                of Helpers that can wield my power.
                
                Do you have what it takes to spark
                the fire kindling in my heart?")
    }
    else
    {
        goto(CastleArena_EventScript_MoveTutorEnabled)
    }
    release   
}

script CastleArena_EventScript_MoveTutorEnabled
{
    msgbox("Having watched your recent victory\.
            I feel so invigorated! Wroaaar!
            
            I know some special moves that can
            be taught to your Helpers.
            
            For the price of ¥1500, I'll train
            them these new techniques.")
    message("What do you say?
            Which move are you interested in?")
    waitmessage()
    showmoneybox(0, 0)
    multichoice(20, 0, MULTI_PALACE_MOVELIST, FALSE)
    copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
    switch(var(VAR_RESULT)) {
	case 0:
		goto(CastleArena_EventScript_Move1)
	case 1:
		goto(CastleArena_EventScript_Move2)
	case 2:
		goto(CastleArena_EventScript_Move3)
    case 3:
		goto(CastleArena_EventScript_Move4)
    case 4:
		goto(CastleArena_EventScript_Move5)
    case MULTI_B_PRESSED:
        goto(WaddleDeeArena_EventScript_MoveTutorLeave)
    }
}

script CastleArena_EventScript_Move1
{
    setvar(VAR_0x8005, MOVE_MYSTICAL_FIRE)
    special(BufferBattleFrontierTutorMoveName)
    checkmoney(1000)
    if(!var(VAR_RESULT))
    {
        goto(WaddleDeeArena_EventScript_CantAfford)
    }
    move_tutor(MOVE_MYSTICAL_FIRE, WaddleDeeArena_Text_TeachMove, WaddleDeeArena_Text_SelectMon, WaddleDeeArena_EventScript_MoveTutorLeave, CastleArena_EventScript_TaughtMove)
}

