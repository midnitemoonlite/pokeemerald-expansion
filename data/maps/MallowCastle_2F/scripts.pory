// Trainers

script MallowCastle_2F_EventScript_Trainer1Battle
{
    playbgm(MUS_ENCOUNTER_FEMALE, 0)
    applymovement(LOCALID_MALLOW_CASTLE_2F_TRAINER_1, Common_Movement_ExclamationMark)
    waitmovement
    delay(60)
    applymovement(LOCALID_MALLOW_CASTLE_2F_TRAINER_1, moves(walk_down * 6))
    waitmovement
    msgbox("Ahhhh, finally! I don't know how long
    I've been stuck back there for!")
    trainerbattle_no_intro(TRAINER_GEORGE, MallowCastle_2F_Text_Trainer1Defeated)
    release
}

script MallowCastle_2F_EventScript_Trainer1
{
    lock
    faceplayer
    msgbox("There's no bomb blocks down this
    corridor. I checked, alright?

    I double-checked, and triple-checked,
    and quadruple-checked, and\. uh\.
    
    What comes after quadruple again\.?
    Anyways, point is, I checked a lot!")
    release
}

text MallowCastle_2F_Text_Trainer1Defeated
{
    "I could use a trip to the break room
    right about now\."
}

script MallowCastle_2F_EventScript_Trainer2
{
    trainerbattle_single(TRAINER_BERKE, MallowCastle_2F_Text_Trainer2Intro, MallowCastle_2F_Text_Trainer2Defeated)
    msgbox(MallowCastle_2F_Text_Trainer2Post, MSGBOX_AUTOCLOSE)
}

text MallowCastle_2F_Text_Trainer2Intro
{
    "I feel right at home next to all these
    bomb blocks!"
}

text MallowCastle_2F_Text_Trainer2Defeated
{
    "Bam! Boom! Kablam!"
}

text MallowCastle_2F_Text_Trainer2Post
{
    "It's been a while since I've gotten to
    do any fun demolition work\.
    
    Maybe I should ask the Great King if we
    can blow up all the Arenas once the
    Royal Royale has wrapped up!"
}

script MallowCastle_2F_EventScript_Trainer3
{
    trainerbattle_single(TRAINER_BRAXTON, MallowCastle_2F_Text_Trainer3Intro, MallowCastle_2F_Text_Trainer3Defeated)
    msgbox(MallowCastle_2F_Text_Trainer3Post, MSGBOX_AUTOCLOSE)
}

text MallowCastle_2F_Text_Trainer3Intro
{
    "If you beat me in a Helper battle, I'll
    tell you what I'd do as king for a day!"
}

text MallowCastle_2F_Text_Trainer3Defeated
{
    "As king, I'd invite everyone to a big
    banquet! Doesn't that sound wonderful?"
}

text MallowCastle_2F_Text_Trainer3Post
{
    "You really like the banquet idea, huh,
    Kirby? I can see it in your eyes\.
    and in your drooling mouth too!"
}