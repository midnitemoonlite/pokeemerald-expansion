script MallowCastle_2F_EventScript_Blockin1
{
    lockall
    setwildbattle(SPECIES_BLOCKIN, 25)
    msgbox("Uh oh! The Star Block was actually
            a Blockin in disguise!")
    playmoncry(SPECIES_BLOCKIN, CRY_MODE_NORMAL)
    waitmoncry
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle()
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    removeobject(LOCALID_BLOCKIN_MALLOW_CASTLE_2F_1)
    setflag(FLAG_TEMP_11)
    release
}

