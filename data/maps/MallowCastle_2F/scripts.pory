raw `
MallowCastle_2F_MapScripts::
	.byte 0
`

script MallowCastle_2F_EventScript_WaddleDee1
{
    lock
    faceplayer
    msgbox("This place is way bigger on the inside
            than it looks from the outside\.
            
            I've lost count of all the bomb blocks
            I needed to hit to reach the next floor.
            
            Maybe I should've brought a map\.")
    release
}

script MallowCastle_2F_EventScript_WaddleDee2
{
    lock
    faceplayer
    msgbox("Hey, are you trying to reach the Castle
            Arena too? Here, let me give you a tip.
            
            You've seen how bomb blocks can cause
            blocks to both appear and disappear?
            
            Sometimes, those blocks might get in
            the way and stop you from continuing.
            
            If you make a mistake, just leave the
            floor and come back. All the blocks
            will return to how they were before.
            
            It's tricky, but don't give up!")
    release
}

// Bomb Blocks

script MallowCastle_2F_EventScript_BombBlock1
{
    lockall
    playse(SE_M_DIG)
    removeobject(LOCALID_BOMB_MALLOW_CASTLE_2F_1)
    setflag(FLAG_TEMP_10)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    playse(SE_M_DIG)
    setmetatile(27, 16, METATILE_LilycoveMuseum_DarkFloor, FALSE)
    special(DrawWholeMapView)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    playse(SE_M_DIG)
    setmetatile(28, 16, METATILE_LilycoveMuseum_Floor, FALSE)
    special(DrawWholeMapView)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    playse(SE_M_DIG)
    setmetatile(29, 16, METATILE_LilycoveMuseum_Floor, FALSE)
    special(DrawWholeMapView)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    release
}

