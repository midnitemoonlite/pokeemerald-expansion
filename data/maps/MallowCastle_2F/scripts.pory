script MallowCastle_2F_EventScript_BombBlock1
{
    lockall
    playse(SE_M_DIG)
    removeobject(LOCALID_BOMB_MALLOW_CASTLE_2F_1)
    setflag(FLAG_TEMP_1B)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    playse(SE_M_DIG)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    playse(SE_M_DIG)
    setmetatile(13, 25, METATILE_LilycoveMuseum_WallTop, TRUE)
    special(DrawWholeMapView)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    playse(SE_M_DIG)
    setmetatile(13, 26, METATILE_LilycoveMuseum_WallBottom, TRUE)
    special(DrawWholeMapView)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    playse(SE_M_DIG)
    setmetatile(13, 27, METATILE_LilycoveMuseum_DarkFloor, FALSE)
    special(DrawWholeMapView)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    playse(SE_M_DIG)
    setmetatile(13, 28, METATILE_LilycoveMuseum_WallLip, FALSE)
    special(DrawWholeMapView)
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 2) // num shakes
	setvar(VAR_0x8007, 3)  // shake delay
	special(ShakeCamera)
    waitstate
    release
}

