script CocoaCave_B2F_EventScript_TooDark
{
    lockall
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    msgbox("No light reaches the path ahead\.
            It's too murky to travel any deeper.")
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_down))
    waitmovement()
    releaseall
}

text CocoaCave_B2F_Text_LittleBrighter
{
    "The cave has gotten a little brighter."
}

text CocoaCave_B2F_Text_LotBrighter
{
    "The cave has gotten a lot brighter!"
}