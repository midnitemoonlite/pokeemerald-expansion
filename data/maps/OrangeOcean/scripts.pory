raw `
OrangeOcean_MapScripts::
    map_script MAP_SCRIPT_ON_FRAME_TABLE, OrangeOcean_OnFrame
	.byte 0

OrangeOcean_OnFrame::
	map_script_2 VAR_ORANGE_OCEAN_STATE, 1, OrangeOcean_EventScript_HalberdTakeOff
	.2byte 0
`

script OrangeOcean_EventScript_HalberdTakeOff
{
    playse(SE_M_EARTHQUAKE)
    setvar(VAR_0x8004, 3)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 20) // num shakes
	setvar(VAR_0x8007, 4)  // shake delay
	special(ShakeCamera)
    waitstate
    setvar(VAR_0x8004, 2)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 14) // num shakes
	setvar(VAR_0x8007, 4)  // shake delay
	special(ShakeCamera)
    waitstate
    setvar(VAR_0x8004, 1)  // vertical pan
	setvar(VAR_0x8005, 0)  // horizontal pan
	setvar(VAR_0x8006, 10) // num shakes
	setvar(VAR_0x8007, 4)  // shake delay
	special(ShakeCamera)
    waitstate
    msgbox("The Halberd has taken off\.")
    closemessage
    setvar(VAR_ORANGE_OCEAN_STATE, 2)
    end
}

script OrangeOcean_EventScript_Sign
{
    msgbox("ORANGE OCEAN
            This shipyard has a storied history.", MSGBOX_SIGN)
    closemessage
}

script OrangeOcean_EventScript_DivingSpot
{
    lockall
    msgbox("You peer beneath the waves\.

            You can faintly make out a massive ship.
            This must be where Kine lost Mine's gift.
            
            Will you dive down and check it out?", MSGBOX_YESNO)
    if(var(VAR_RESULT))
    {
        warp(MAP_BATTLESHIP_HALBERD_DIVE_ROOM, 3, 13)
        releaseall
    }
    else
    {
        releaseall
    }
}

script OrangeOcean_EventScript_WaddleDee
{
    lock
    faceplayer
    msgbox("The water here is unusually shallow,
            and a lot of underlying rock is exposed.
            
            It's made it difficult for ships to
            reach the Rest Area\.
            
            I'm sure it'll go back to normal on its
            own, so I'm fine waiting here, but
            how could this have happened?")
    release
}

script OrangeOcean_EventScript_Nurse
{
    lock
    faceplayer
    msgbox("I haven't been able to shake this
            sinister feeling since my ship docked\.
            
            Are your Helpers doing alright? Here,
            let me heal them for you.")
    closemessage
	fadescreenswapbuffers(FADE_TO_BLACK)
	playfanfare(MUS_HEAL)
	waitfanfare()
	special(HealPlayerParty)
	fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox("Wherever you go, please be careful!")
    release
}

script OrangeOcean_EventScript_Trainer1
{
    trainerbattle_single(TRAINER_DUSTY_4, OrangeOcean_Text_Trainer1Intro, OrangeOcean_Text_Trainer1Defeated)
    msgbox(OrangeOcean_Text_Trainer1Post, MSGBOX_AUTOCLOSE)
}

text OrangeOcean_Text_Trainer1Intro
{
    "My Helpers have the home-field
    advantage at sea!"
}

text OrangeOcean_Text_Trainer1Defeated
{
    "If I can't win at sea, how will
    I win at the Arenas on land?"
}

text OrangeOcean_Text_Trainer1Post
{
    "It would be nice if one of the Arenas
    took place in the water\."
}

script OrangeOcean_EventScript_Trainer2
{
    trainerbattle_single(TRAINER_DUSTY_5, OrangeOcean_Text_Trainer2Intro, OrangeOcean_Text_Trainer2Defeated)
    msgbox(OrangeOcean_Text_Trainer2Post, MSGBOX_AUTOCLOSE)
}

text OrangeOcean_Text_Trainer2Intro
{
    "Oh no! That Helper's trying to eat
    someone! Don't worry! I'll save you!"
}

text OrangeOcean_Text_Trainer2Defeated
{
    "That fishy fellow\. isn't a Helper?"
}

text OrangeOcean_Text_Trainer2Post
{
    "Oh, so you're being ferried by your
    friend Kine? That's nice!
    
    I'm sorry for thinking you were a
    dangerous Helper, Kine! Silly me,
    thinking Helpers would attack others\."
}

script OrangeOcean_EventScript_Trainer3
{
    trainerbattle_single(TRAINER_GABBY_AND_TY_1, OrangeOcean_Text_Trainer3Intro, OrangeOcean_Text_Trainer3Defeated)
    msgbox(OrangeOcean_Text_Trainer3Post, MSGBOX_AUTOCLOSE)
}

text OrangeOcean_Text_Trainer3Intro
{
    "I love swimming with my Helper!"
}

text OrangeOcean_Text_Trainer3Defeated
{
    "We may not be training as much as we
    swim, but that's okay!"
}

text OrangeOcean_Text_Trainer3Post
{
    "I gave my Blipper a special Heart, and
    then it became a Mamatee. Neat, huh?"
}

script OrangeOcean_EventScript_Trainer4
{
    trainerbattle_single(TRAINER_GABBY_AND_TY_2, OrangeOcean_Text_Trainer4Intro, OrangeOcean_Text_Trainer4Defeated)
    msgbox(OrangeOcean_Text_Trainer4Post, MSGBOX_AUTOCLOSE)
}

text OrangeOcean_Text_Trainer4Intro
{
    "I've got so much free time now that
    I'm stuck on this island\."
}

text OrangeOcean_Text_Trainer4Defeated
{
    "No time to learn like the present,
    right?"
}

text OrangeOcean_Text_Trainer4Post
{
    "Moves, stats, types\. there's so much
    that goes into Helper battles.
    
    How does the Great King remember all
    of it? He must have a huge brain!
    Almost as big as his mouth and hammer!"
}

script OrangeOcean_EventScript_Trainer5
{
    trainerbattle_single(TRAINER_GABBY_AND_TY_3, OrangeOcean_Text_Trainer5Intro, OrangeOcean_Text_Trainer5Defeated)
    msgbox(OrangeOcean_Text_Trainer5Post, MSGBOX_AUTOCLOSE)
}

text OrangeOcean_Text_Trainer5Intro
{
    "My ship can't reach the mainland!
    You know what we do in times like this?
    Throw our hands in the air and panic!"
}

text OrangeOcean_Text_Trainer5Defeated
{
    "Ahhhhhhh!!!"
}

text OrangeOcean_Text_Trainer5Post
{
    "I'll be honest: I'm not sure if losing a
    Helper battle made me feel any better.
    I was hoping it would distract me\."
}

script OrangeOcean_EventScript_Trainer6
{
    trainerbattle_single(TRAINER_GABBY_AND_TY_4, OrangeOcean_Text_Trainer6Intro, OrangeOcean_Text_Trainer6Defeated)
    msgbox(OrangeOcean_Text_Trainer6Post, MSGBOX_AUTOCLOSE)
}

text OrangeOcean_Text_Trainer6Intro
{
    "I'm not stranded here\. I just don't
    want to travel through Cocoa Cave!"
}

text OrangeOcean_Text_Trainer6Defeated
{
    "Traveling through the dark is so scary\."
}

text OrangeOcean_Text_Trainer6Post
{
    "Huh? There's a shortcut through the
    water that lets you avoid the dark?
    Wow, amazing! Thank you for telling me!"
}