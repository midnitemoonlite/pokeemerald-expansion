raw `
MallowCastle_3F_MapScripts::
	.byte 0
`

script MallowCastle_3F_EventScript_WaddleDee
{
    lock
    faceplayer
    msgbox("Hi, Kirby! Do you like my corner?
            I think it's pretty cozy.
            We can share if you'd like!
            
            What's that? You stumbled in here by
            accident looking for the Castle Arena?
            
            Oh\. alright. Well, more corner for me!")
    release
}

// Trainers

script MallowCastle_3F_EventScript_Trainer1
{
    trainerbattle_single(TRAINER_VINCENT, MallowCastle_3F_Text_Trainer1Intro, MallowCastle_3F_Text_Trainer1Defeated)
    msgbox(MallowCastle_3F_Text_Trainer1Post, MSGBOX_AUTOCLOSE)
}

text MallowCastle_3F_Text_Trainer1Intro
{
    "Oh, dearie me. It seems my Helpers are
    itching for a proper battle!"
}

text MallowCastle_3F_Text_Trainer1Defeated
{
    "I hope your Helpers enjoyed their
    playtime as well!"
}

text MallowCastle_3F_Text_Trainer1Post
{
    "My Helpers are so battle-hungry\. I wish
    I could just go home and spoil them!"
}

script MallowCastle_3F_EventScript_Trainer2
{
    trainerbattle_single(TRAINER_LEROY, MallowCastle_3F_Text_Trainer2Intro, MallowCastle_3F_Text_Trainer2Defeated)
    msgbox(MallowCastle_3F_Text_Trainer2Post, MSGBOX_AUTOCLOSE)
}

text MallowCastle_3F_Text_Trainer2Intro
{
    "Finally, a fresh face! Goodness knows
    how long I've been lost in here!"
}

text MallowCastle_3F_Text_Trainer2Defeated
{
    "So strong! Please, show me the way out!"
}

text MallowCastle_3F_Text_Trainer2Post
{
    "I tried using my cell phone to call for
    an exit, but it's out of battery!
    
    If you find any spare batteries lying
    around, please tell me!"
}

script MallowCastle_3F_EventScript_Trainer3
{
    lock
    faceplayer
    msgbox("You get a lot of time to think when you
            sit behind a nigh-indestructible wall.")
    release
}

text MallowCastle_3F_Text_Trainer3Defeated
{
    "All of that waiting, and I couldn't even
    scrape up a victory\."
}

script MallowCastle_3F_EventScript_Trainer3Battle
{
    playbgm(MUS_ENCOUNTER_HIKER, 0)
    applymovement(LOCALID_MALLOW_CASTLE_3F_TRAINER_3, Common_Movement_ExclamationMark)
    waitmovement
    delay(60)
    getplayerxy(VAR_TEMP_5, VAR_TEMP_6)
    if(var(VAR_TEMP_5) == 6)
    {
        applymovement(LOCALID_MALLOW_CASTLE_3F_TRAINER_3, moves(walk_down * 2, walk_left * 3))
        waitmovement()
    }
    elif(var(VAR_TEMP_5) == 7)
    {
        applymovement(LOCALID_MALLOW_CASTLE_3F_TRAINER_3, moves(walk_down * 3, walk_left * 2))
        waitmovement()
        applymovement(LOCALID_PLAYER, moves(face_right))
        waitmovement()
    }
    else
    {
        applymovement(LOCALID_MALLOW_CASTLE_3F_TRAINER_3, moves(walk_down * 2, walk_left))
        waitmovement()
        applymovement(LOCALID_PLAYER, moves(face_right))
        waitmovement()
    }
    msgbox("I caught you in my line of sight while
            you were wondering what block to hit!
            
            Now that I'm free, I can finally
            challenge you to a Helper battle!")
    trainerbattle_no_intro(TRAINER_WILTON_1, MallowCastle_3F_Text_Trainer3Defeated)
    msgbox("Sigh\. I guess I'll go back and sit in
            my hole in shame\.")
    closemessage
    if(var(VAR_TEMP_5) == 6)
    {
        applymovement(LOCALID_MALLOW_CASTLE_3F_TRAINER_3, moves(walk_right * 3, walk_up * 2, walk_in_place_down))
        waitmovement()
    }
    elif(var(VAR_TEMP_5) == 7)
    {
        applymovement(LOCALID_MALLOW_CASTLE_3F_TRAINER_3, moves(walk_right * 2, walk_up * 3, walk_in_place_down))
        waitmovement()
    }
    else
    {
        applymovement(LOCALID_MALLOW_CASTLE_3F_TRAINER_3, moves(walk_right, walk_up * 2, walk_in_place_down))
        waitmovement()
    }
    release
}

