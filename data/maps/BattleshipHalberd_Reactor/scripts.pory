BattleshipHalberd_Reactor_EventScript_Switch1Pressed::
	setvar VAR_0x8004, 0
	special MauvilleGymPressSwitch
	goto BattleshipHalberd_Reactor_EventScript_UpdateBarriers
	end

BattleshipHalberd_Reactor_EventScript_Switch2Pressed::
	setvar VAR_0x8004, 1
	special MauvilleGymPressSwitch
	goto BattleshipHalberd_Reactor_EventScript_UpdateBarriers
	end

BattleshipHalberd_Reactor_EventScript_Switch3Pressed::
	setvar VAR_0x8004, 2
	special MauvilleGymPressSwitch
	goto BattleshipHalberd_Reactor_EventScript_UpdateBarriers
	end

BattleshipHalberd_Reactor_EventScript_Switch4Pressed::
	setvar VAR_0x8004, 3
	special MauvilleGymPressSwitch
	goto BattleshipHalberd_Reactor_EventScript_UpdateBarriers
	end

BattleshipHalberd_Reactor_EventScript_Switch5Pressed::
	setvar VAR_0x8004, 4
	special MauvilleGymPressSwitch
	goto BattleshipHalberd_Reactor_EventScript_UpdateBarriers
	end

BattleshipHalberd_Reactor_EventScript_Switch1::
	lockall
	goto_if_eq VAR_MAUVILLE_GYM_STATE, 1, BattleshipHalberd_Reactor_EventScript_SwitchDoNothing
	setvar VAR_MAUVILLE_GYM_STATE, 1
	setvar VAR_0x8004, 0
	goto BattleshipHalberd_Reactor_EventScript_PressFloorSwitch
	end

BattleshipHalberd_Reactor_EventScript_Switch2::
	lockall
	goto_if_eq VAR_MAUVILLE_GYM_STATE, 2, BattleshipHalberd_Reactor_EventScript_SwitchDoNothing
	setvar VAR_MAUVILLE_GYM_STATE, 2
	setvar VAR_0x8004, 1
	goto BattleshipHalberd_Reactor_EventScript_PressFloorSwitch
	end

BattleshipHalberd_Reactor_EventScript_Switch3::
	lockall
	goto_if_eq VAR_MAUVILLE_GYM_STATE, 3, BattleshipHalberd_Reactor_EventScript_SwitchDoNothing
	setvar VAR_MAUVILLE_GYM_STATE, 3
	setvar VAR_0x8004, 2
	goto BattleshipHalberd_Reactor_EventScript_PressFloorSwitch
	end

BattleshipHalberd_Reactor_EventScript_Switch4::
	lockall
	goto_if_eq VAR_MAUVILLE_GYM_STATE, 4, BattleshipHalberd_Reactor_EventScript_SwitchDoNothing
	setvar VAR_MAUVILLE_GYM_STATE, 4
	setvar VAR_0x8004, 3
	goto BattleshipHalberd_Reactor_EventScript_PressFloorSwitch
	end

BattleshipHalberd_Reactor_EventScript_Switch5::
	lockall
	goto_if_eq VAR_MAUVILLE_GYM_STATE, 5, BattleshipHalberd_Reactor_EventScript_SwitchDoNothing
	setvar VAR_MAUVILLE_GYM_STATE, 5
	setvar VAR_0x8004, 4
	goto BattleshipHalberd_Reactor_EventScript_PressFloorSwitch
	end

BattleshipHalberd_Reactor_EventScript_PressFloorSwitch::
    special MauvilleGymSetDefaultBarriers
	special MauvilleGymPressSwitch
	special DrawWholeMapView
	playse SE_UNLOCK
	goto_if_set FLAG_MAUVILLE_GYM_BARRIERS_STATE, BattleshipHalberd_Reactor_EventScript_ClearBarriersAltState
	goto_if_unset FLAG_MAUVILLE_GYM_BARRIERS_STATE, BattleshipHalberd_Reactor_EventScript_SetBarriersAltState
	releaseall
	end

BattleshipHalberd_Reactor_EventScript_SetBarriersAltState::
	setflag FLAG_MAUVILLE_GYM_BARRIERS_STATE
	releaseall
	end

BattleshipHalberd_Reactor_EventScript_ClearBarriersAltState::
	clearflag FLAG_MAUVILLE_GYM_BARRIERS_STATE
	releaseall
	end

BattleshipHalberd_Reactor_EventScript_SwitchDoNothing::
	releaseall
	end
`

script BattleshipHalberd_Reactor_EventScript_Wheelie
{
    lock
    faceplayer
    playmoncry(SPECIES_WHEELIE_BIKE, CRY_MODE_NORMAL)
    msgbox("It's a Wheelie Bike. Seems like it
            escaped from the power generator\.
            
            The Wheelie looks at you expectantly.
            Will you let it join your party?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES)
    {
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_WHEELIE_BIKE)
        givemon(SPECIES_WHEELIE_BIKE, 24)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY)
        {
            playfanfare(MUS_EVOLVED)
            message("You obtained Wheelie!")
            waitmessage()
            waitfanfare()
            msgbox("Would you like to give a nickname to
                    Wheelie?", MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
             {
                call(Common_EventScript_GetGiftMonPartySlot)
                call(Common_EventScript_NameReceivedPartyMon)
             }
        }
        if(var(VAR_RESULT) == MON_GIVEN_TO_PC)
        {
            playfanfare(MUS_EVOLVED)
            message("You obtained Wheelie!")
            waitmessage()
            waitfanfare()
            msgbox("Would you like to give a nickname to
                    Wheelie?", MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES)
             {
                call(Common_EventScript_NameReceivedBoxMon)
             }
            call(Common_EventScript_TransferredToPC)
        }
        setflag(FLAG_OBTAINED_WHEELIE)
        removeobject(LOCALID_WHEELIE_BIKE)
        release
    }
    else
    {
        release
    }
}

script BattleshipHalberd_Reactor_EventScript_Trainer
{
    trainerbattle_single(TRAINER_AUSTINA, BattleshipHalberd_Reactor_Text_TrainerIntro, BattleshipHalberd_Reactor_Text_TrainerDefeated)
    msgbox(BattleshipHalberd_Reactor_Text_TrainerPost, MSGBOX_AUTOCLOSE)
}

text BattleshipHalberd_Reactor_Text_TrainerIntro
{
    "What do you think you're doing here?
    The reactor's a highly sensitive place!
    
    I kindly suggest you take your leave.
    And I won't take anything else kindly!"
}

text BattleshipHalberd_Reactor_Text_TrainerDefeated
{
    "Yow ow ow! Okay, fine, I'll tell you how
    to get past here!"
}

text BattleshipHalberd_Reactor_Text_TrainerPost
{
    "We installed electric gates to protect
    the reactor and its several generators.

    You see the lightning-bolt tiles on the
    floor? The electric gates will change
    positions when you step on them.
    
    Find a way to the top-right generator,
    and you can open up an elevator that
    will lead you directly to the helm.
    
    You hear that? The top right generator!
    Don't go activating any others, now!"
}

script BattleshipHalberd_Reactor_EventScript_SailorWaddleDee
{
    lock
    faceplayer
    msgbox("Kirby! How did you get here? If Lord
            Meta Knight sees you, he'll\.
            
            \.huh? You're looking for a gift that
            fell in the ocean around here?
            
            Oh! Yes! I hauled in something like that
            earlier! It looked too nice to toss, so
            I ended up giving it to the captain\.
            
            He might still have it, but\. well, good
            luck getting it without being caught!")
    closemessage
    if(var(VAR_SAILOR_QUEST) == 1)
    {
        playse(SE_PIN)
        applymovement(LOCALID_SAILOR_REACTOR, Common_Movement_QuestionMark)
        waitmovement()
        waitse()
        msgbox("What's that? You have something else
                you want to ask me about? If I know
                a lumberjack by the resort?
                
                Wow! Yes, it's been a while!
                They're wondering how I'm doing? Hm\.")
        closemessage()
        delay(90)
        msgbox("Here. Can you do me a favor and deliver
                this letter to them?")
        giveitem_msg(BattleshipHalberd_Reactor_Text_ReceivedLetter, ITEM_LETTER, 1, MUS_RG_OBTAIN_KEY_ITEM)
        msgbox("It's hard work here on the Halberd, so I
                don't get a lot of free time.
                
                Even if I may not be able to see them,
                I hope this will satisfy them!")
        setvar(VAR_SAILOR_QUEST, 2)
    }
    release
}

script BattleshipHalberd_Reactor_EventScript_MiddleSwitch
{
    lockall
    if(!flag(FLAG_BATTLESHIP_HALBERD_REACTOR_MIDDLE_GATE))
    {
        msgbox("It's a power switch. Will you flip it?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES)
        {
            msgbox("You flipped the power switch!")
            closemessage
            playse(SE_BANG)
            setvar(VAR_0x8004, 2)  // vertical pan
            setvar(VAR_0x8005, 0)  // horizontal pan
            setvar(VAR_0x8006, 2) // num shakes
            setvar(VAR_0x8007, 3)  // shake delay
            special(ShakeCamera)
            setmetatile(9, 11, METATILE_MauvilleGym_BattleshipHalberd_Reactor_LeftTile, FALSE)
            setmetatile(10, 11, METATILE_MauvilleGym_BattleshipHalberd_Reactor_RightTile, FALSE)
            setmetatile(9, 12, METATILE_MauvilleGym_BattleshipHalberd_Reactor_LeftTile, FALSE)
            setmetatile(10, 12, METATILE_MauvilleGym_BattleshipHalberd_Reactor_RightTile, FALSE)
            special(DrawWholeMapView)
            waitse
            delay(12)
            msgbox("A locked path opened up!")
            setflag(FLAG_BATTLESHIP_HALBERD_REACTOR_MIDDLE_GATE)
            releaseall
        }
        else
        {
            releaseall
        }
    }
    else
    {
        msgbox("This switch has already been flipped.")
        releaseall
    }
}

script BattleshipHalberd_Reactor_EventScript_RemoveMiddleGate
{
    setmetatile(9, 11, METATILE_MauvilleGym_BattleshipHalberd_Reactor_LeftTile, FALSE)
    setmetatile(10, 11, METATILE_MauvilleGym_BattleshipHalberd_Reactor_RightTile, FALSE)
    setmetatile(9, 12, METATILE_MauvilleGym_BattleshipHalberd_Reactor_LeftTile, FALSE)
    setmetatile(10, 12, METATILE_MauvilleGym_BattleshipHalberd_Reactor_RightTile, FALSE)
    return
}

