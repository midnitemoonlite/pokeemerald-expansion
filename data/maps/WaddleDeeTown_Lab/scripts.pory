    giveitem_msg(WaddleDeeTown_Lab_ReceivedExpCharm, ITEM_EXP_CHARM, 1, MUS_RG_OBTAIN_KEY_ITEM)
    giveitem(ITEM_TM06)
    giveitem(ITEM_BIG_NUGGET)
    giveitem(ITEM_MASTER_BALL)
    msgbox("{SPEAKER NAME_WISE}It includes a TM, a new Heart, some
            valuables, and most importantly:
            the Experience Charm!
            
            This is the ultimate tool to bolster
            your party's experience gains.
            
            Evolving Helpers should be easier
            than ever with this by your side.
            
            And if there any uncaptured Helpers
            still eluding you, I've bestowed
            the ultimate Heart unto you as well.
            
            The Master Heart can never fail.
            Use it wisely, my good friend!")
    setflag(FLAG_BINDER_GATE_07)
}

script WaddleDeeTown_Lab_EvaluateCards
{
    setvar(VAR_0x8004, 0)
	specialvar(VAR_RESULT, ScriptGetPokedexInfo)
	copyvar(VAR_0x8008, VAR_0x8005)
	copyvar(VAR_0x8009, VAR_0x8006)
	copyvar(VAR_0x800A, VAR_RESULT)
	buffernumberstring(STR_VAR_2, VAR_0x8009)
}

script WaddleDeeTown_Lab_EventScript_TurnLeft
{
    turnobject(LOCALID_LAB_RECEPTIONIST_LEFT, DIR_EAST)
    goto(WaddleDeeTown_Lab_EventScript_LeftReceptionist)
}

script WaddleDeeTown_Lab_EventScript_TurnRight
{
    turnobject(LOCALID_LAB_RECEPTIONIST_RIGHT, DIR_WEST)
    goto(WaddleDeeTown_Lab_EventScript_RightReceptionist)
}

script WaddleDeeTown_Lab_EventScript_Book1
{
    lockall
    msgbox("Kawasaki's Chef Training: Curry
    
            \qoThe Superspicy Curry is my specialty
            dish! It's so delicious, you'll beg
            for dozens of drinks to savor it with!
            
            Ingredients: rice, beef, broth, cumin,
            coriander, cinnamon, garlic, sesame,
            hot sauce, jalapeno, tabasco, cayenne,
            hot sauce, habanero, hot sauce, 
            ghost pepper, hot sauce, hot sauce,
            hot sauce, hot sauce, hot sauce,
            hot sauce, hot sauce, hot sauce,
            hot sauce, hot sauce, hot sauce,\qc
            
            You close the book concernedly.")
    release
}

script WaddleDeeTown_Lab_EventScript_Book2
{
    lockall
    msgbox("Kawasaki's Chef Training: Ice Pops
    
            \qoThis treat is perfect for cooling off
            after a hot summer day\. or after eating
            my famous Superspicy Curry!
            
            Ingredients: water, sticks
            
            Step 1: Pour water into a cube or tube
            tray.
            
            Step 2: Place sticks in tray slots,
            partially submerged into water.
            
            Step 3: Place in freezer until ready.
            
            \. 
            
            I know what you're thinking. That's it?
            This barely counts as a recipe!
            
            But that's exactly the point! Even
            head chefs like me started somewhere!
            
            Anyone can learn to cook as good as I
            do, if only you apply yourself right.
            So don't let yourself be intimidated!\qc")
    release
}

script WaddleDeeTown_Lab_EventScript_Book3
{
    lockall
    msgbox("On The Making Of A King: Part 1
    
            \qoYa might be wonderin': why write a
            series on how I serve as king?
            
            Is this even useful to a citizenry
            full of a bunch of illiterate folks?
            
            Well, I think so! And here, I'll
            tell y'all why!
            
            Number one: I'm a great enough king
            to deserve havin' my accomplishments
            immortalized in a fancy book!
            
            Number two: if the population learns to
            read later on, they should know the
            best king there was and ever will be!
            
            Number three: Proofreadin' all dis is
            gonna make me a better reader too!\qc")
    release
}

script WaddleDeeTown_Lab_EventScript_Book4
{
    lockall
    msgbox("On The Making Of A King: Part 4
    
            \qoLemme let y'all in on a little secret,
            from generous king to feeble subject.
            
            Ya do NOT want a guy like Meta Knight
            rulin' over you. Yeesh!
            
            He's so stern and tough! What a killjoy!
            Doesn't he get the vibe of this place?
            
            And all of his orders are about trainin'
            and fightin' and whatnot! It's tirin'!
            
            My orders are easy things! Like strokin'
            my ego or grabbin' me some grub!
            
            Kirby stopped that knucklehead from
            takin' over Dream Land once\. huh,
            what do I think of Kirby bein' king?
            
            Hrmmm\. nope. He's got no shot.\qc")
    release
}

script WaddleDeeTown_Lab_EventScript_Book5
{
    lockall
    msgbox("On The Making of a King: Part 13
    
            \qoNotice: The accounts you are about to
            read are products of their time.
            
            They reflect behavior that was wrong
            then and now, but nonetheless was
            commonplace in the distant past.
            
            The events have been preserved here
            so as not to erase their existence.\qc
            
            \.it then describes several of King
            Dedede's misadventures in Dream Land.")
    release
}

