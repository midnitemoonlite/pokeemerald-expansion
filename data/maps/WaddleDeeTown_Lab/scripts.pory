script WaddleDeeTown_Lab_EventScript_Book27
{
    lockall
    msgbox("Helper Handbook: Evolution Stars
    
            \qoSome Helpers evolve into new species
            when exposed to certain starry items.
            
            However, there is a catch: most of
            these Helpers will appear to stop
            learning new moves upon evolution.
            
            They'll only begin to learn new moves
            at the level at which the unevolved
            Helper would have mastered its moves.
            
            As an aside\.
            
            If a Helper learns a move that its
            evolved form doesn't get, don't fret.
            
            That move still exists deep in the
            evolved Helper's egg movepool,
            and can be learned by other means.\qc")
    release
}

