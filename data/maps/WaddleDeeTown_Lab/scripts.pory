script WaddleDeeTown_Lab_EventScript_Book8
{
    lockall
    msgbox("Diary of a Waddle Dee
    
            \qoI've never seen a library this big in
            my life before. It's huge!
            
            I was wondering, would they notice if
            one extra book came in or out of here?
            
            So I figured, for fun, I'd write a little
            diary, sneak it into the library, and
            then hide it among the shelves.
            
            If it gets noticed and removed, well,
            I guess I won't know if that happens\.
            
            But if someone happens to be reading
            this, please tell me if it's still there!
            
            I live around Grape Garden, so I can't
            visit the library in town so often\.\qc")
    if(!flag(FLAG_READ_DIARY))
    {
        setflag(FLAG_READ_DIARY)
    }
    release
}

