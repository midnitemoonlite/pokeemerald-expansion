raw `
ResortArena_Mart_MapScripts::
	.byte 0
`

script ResortArena_Mart_EventScript_Clerk
{
	lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
	pokemart(ResortArena_Mart)
	msgbox(gText_PleaseComeAgain)
	release
	end
}

mart ResortArena_Mart
{
    ITEM_POKE_BALL
    ITEM_DIVE_BALL
    ITEM_POTION
    ITEM_SUPER_POTION
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_BURN_HEAL
    ITEM_REPEL
    ITEM_POKE_DOLL
    ITEM_DIRE_HIT
}

script ResortArena_Mart_EventScript_Youngster
{
    lock
    faceplayer
    msgbox("It's been a while since I've thought to
            restock on items. What do I need?
            
            Let's see\. Friend Hearts, drinks\.
            Maybe an Awakening for good measure\.")
    release
}

script ResortArena_Mart_EventScript_Manager
{
    lock
    faceplayer
    msgbox("It's hard work, making sure our guests
            have a carefree and relaxing stay.
            
            I wonder if I'm starting to build the
            opposite association with resorts\.")
    release
}

script ResortArena_Mart_EventScript_MoveTutor
{
    lock
    faceplayer
    if(!flag(FLAG_BADGE02_GET))
    {
        msgbox(MoveTutor_Text_MoveTutorNotEnabled, MSGBOX_DEFAULT)
    }
    else
    {
        goto(ResortArena_Mart_EventScript_MoveTutorEnabled)
    }
    release   
}

script ResortArena_Mart_EventScript_MoveTutorEnabled
{
    msgbox("Having heard of your recent victory\.
            I feel so invigorated! Wroaaar!
            
            I know some special moves that can
            be taught to your Helpers.
            
            For the price of ¥1000, I'll train
            them these new techniques.")
    message("What do you say?
            Which move are you interested in?")
    waitmessage()
    showmoneybox(0, 0)
    multichoice(20, 0, MULTI_RESORT_MOVELIST, FALSE)
    copyvar(VAR_TEMP_FRONTIER_TUTOR_SELECTION, VAR_RESULT)
    switch(var(VAR_RESULT)) {
	case 0:
		goto(ResortArena_Mart_EventScript_Move1)
	case 1:
		goto(ResortArena_Mart_EventScript_Move2)
	case 2:
		goto(ResortArena_Mart_EventScript_Move3)
    case 3:
		goto(ResortArena_Mart_EventScript_Move4)
    case 4:
		goto(ResortArena_Mart_EventScript_Move5)
    case MULTI_B_PRESSED:
        goto(MoveTutor_EventScript_MoveTutorLeave)
    }
}

script ResortArena_Mart_EventScript_Move1
{
    setvar(VAR_0x8005, MOVE_ICY_WIND)
    special(BufferBattleFrontierTutorMoveName)
    checkmoney(1000)
    if(!var(VAR_RESULT))
    {
        goto(MoveTutor_EventScript_CantAfford)
    }
    move_tutor(MOVE_ICY_WIND, MoveTutor_Text_TeachMove, MoveTutor_Text_SelectMon, MoveTutor_EventScript_MoveTutorLeave, ResortArena_Mart_EventScript_TaughtMove)
}

