script WaddleDeeTown_Cafe_EventScript_IngredientMenu
{
	lock
	faceplayer
    if(!flag(FLAG_BADGE04_GET))
    {
        msgbox("I'm sorry, but we're still a bit low on
            supply for seasonings\.
            
            Once some more shipments arrive, I'll
            be happy to sell you our offerings.")
    }
    else
    {
        message("We serve seasonings here!
                What can I get for you today?")
	    waitmessage
        if(flag(FLAG_IS_CHAMPION))
        {
            pokemart2(WaddleDeeTown_Cafe_SeasoningMart9)
        }
        elif(flag(FLAG_BADGE08_GET))
        {
            pokemart2(WaddleDeeTown_Cafe_SeasoningMart8)
        }
        elif(flag(FLAG_BADGE07_GET))
        {
            pokemart2(WaddleDeeTown_Cafe_SeasoningMart7)
        }
        elif(flag(FLAG_BADGE06_GET))
        {
            pokemart2(WaddleDeeTown_Cafe_SeasoningMart6)
        }
        elif(flag(FLAG_BADGE05_GET))
        {
            pokemart2(WaddleDeeTown_Cafe_SeasoningMart5)
        }
        else
        {
            pokemart2(WaddleDeeTown_Cafe_SeasoningMart4)
        }
	    msgbox(gText_PleaseComeAgain)
    }
    release
    end
}

script WaddleDeeTown_Cafe_EventScript_BerryDesk
{
    turnobject(LOCALID_CAFE_BERRY_SERVER, DIR_SOUTH)
    goto(WaddleDeeTown_Cafe_EventScript_BerryMenu)
}

script WaddleDeeTown_Cafe_EventScript_DrinkDesk
{
    turnobject(LOCALID_CAFE_DRINK_SERVER, DIR_SOUTH)
    goto(WaddleDeeTown_Cafe_EventScript_DrinkMenu)
}

